      {
        "type": "stat",
        "title": "Stop-Loss Events",
        "targets": [
          { "expr": "dynasty_stop_loss_events" }
        ],
        "gridPos": { "x": 12, "y": 4, "w": 6, "h": 4 }
      },
      {
        "type": "graph",
        "title": "Backtest Sharpe Ratio",
        "targets": [
          { "expr": "dynasty_backtest_sharpe" }
        ],
        "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 }
