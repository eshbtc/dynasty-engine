# Supabase configuration - Get from your Supabase project settings
# Public keys are safe to expose in client-side code
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Prometheus endpoint for fetching metrics
# Ensure this is accessible from the browser where the portal runs
# Or, consider a backend proxy API route if Prometheus requires auth or isn't public
NEXT_PUBLIC_PROM_URL=http://localhost:9090 # Example: Local Prometheus
# NEXT_PUBLIC_PROM_URL=https://dynasty-prom.yourdomain.com # Example: Deployed Prometheus

# Supabase Service Key (Secret) - ONLY FOR SERVER-SIDE USE (e.g., in API routes)
# DO NOT EXPOSE THIS IN CLIENT-SIDE CODE (prefix with NEXT_PUBLIC_)
# Required for the /api/report route to securely download from storage
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
